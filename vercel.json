{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/live-class.js",
      "destination": "/public/live-class.js"
    },
    {
      "source": "/live-class.css",
      "destination": "/public/live-class.css"
    },
    {
      "source": "/(favicon-32\\.png|favicon-512\\.png|apple-touch-icon\\.png|favicon\\.ico)",
      "destination": "/public/$1"
    },
    {
      "source": "/cal/([0-9a-f]+)\\.ics",
      "destination": "/api/calendar/feed?token=$1"
    },
    {
      "source": "/csv-import.js",
      "destination": "/public/csv-import.js"
    },
    {
      "source": "/groups-calendar.js",
      "destination": "/public/groups-calendar.js"
    },
    {
      "source": "/groups-calendar.css",
      "destination": "/public/groups-calendar.css"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.html"
    }
  ],
  "functions": {
    "api/generate.js": {
      "maxDuration": 60
    }
  }
}
